AUTH_SECRET=
# Hash of the owner's password: `node scripts/hash-password.mjs` (prints a random password and its hash).
AUTH_PASSWORD_HASH=
ALLOWED_EMAILS=you@example.com
AI_GATEWAY_API_KEY=
BLOB_READ_WRITE_TOKEN=
DATABASE_URL=
MAX_GENERATION_COST_USD=5
DAILY_GENERATION_BUDGET_USD=20

# Optional local-only UI preview. Ignored in production and on non-local hosts.
LOCAL_PREVIEW=false

# Where the MCP server writes generated media (absolute, or relative to the client's working directory).
STUDIO_OUTPUT_DIR=generated-media

# Hosted MCP for Claude Cloud connectors: /api/mcp on Vercel, or `npm run mcp:http` / Dockerfile.mcp elsewhere.
# Secret required to call the endpoint (at least 24 characters): `openssl rand -hex 32`.
MCP_AUTH_TOKEN=
# Standalone server only: public https address (no trailing slash) used to build download links,
# and the directory where it stores generated files (default ./generated-media).
# On Vercel, files go to Blob (BLOB_READ_WRITE_TOKEN above) and these two are not used.
MCP_PUBLIC_URL=
MCP_FILES_DIR=

# Studio library: workspaces, elements (characters, avatars, places…) and the gallery, stored on disk.
STUDIO_DATA_DIR=data

# Public address of this deployment (no trailing slash). Required for video models that only accept
# `url` inputs (Wan, Seedance, MiniMax…): reference images and synthesized voice tracks are served
# through signed links under /api/studio/public/. Leave empty on a laptop without a public address.
STUDIO_PUBLIC_URL=
# Secret used to sign those links (falls back to AUTH_SECRET).
STUDIO_MEDIA_SECRET=
