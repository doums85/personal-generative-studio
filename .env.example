AUTH_SECRET=
# Hash of the owner's password: `node scripts/hash-password.mjs` (prints a random password and its hash).
AUTH_PASSWORD_HASH=
ALLOWED_EMAILS=you@example.com
AI_GATEWAY_API_KEY=
BLOB_READ_WRITE_TOKEN=
DATABASE_URL=
MAX_GENERATION_COST_USD=5
DAILY_GENERATION_BUDGET_USD=20

# Optional local-only UI preview. Ignored in production and on non-local hosts.
LOCAL_PREVIEW=false

# Where the MCP server writes generated media (absolute, or relative to the client's working directory).
STUDIO_OUTPUT_DIR=generated-media

# Hosted MCP for Claude Cloud connectors: /api/mcp on Vercel, or `npm run mcp:http` / Dockerfile.mcp elsewhere.
# Secret required to call the endpoint (at least 24 characters): `openssl rand -hex 32`.
MCP_AUTH_TOKEN=
# Standalone server only: public https address (no trailing slash) used to build download links,
# and the directory where it stores generated files (default ./generated-media).
# On Vercel, files go to Blob (BLOB_READ_WRITE_TOKEN above) and these two are not used.
MCP_PUBLIC_URL=
MCP_FILES_DIR=

# Studio library: workspaces, elements (characters, avatars, places…), the gallery, social accounts and publications.
# Stored in Convex when CONVEX_URL is set: `npm run convex:dev` (local, writes CONVEX_URL) then `npm run convex:setup`
# (creates STUDIO_SERVICE_PRIVATE_KEY, the key the studio's servers use to sign their calls to Convex).
# In production: `npx convex deploy`, `npm run convex:setup -- --prod`, then set both variables on your host.
CONVEX_URL=
STUDIO_SERVICE_PRIVATE_KEY=
# Without Convex the library is stored on disk instead (also the source of `npm run convex:import`).
STUDIO_DATA_DIR=data

# Public address of this deployment (no trailing slash). Required for video models that only accept
# `url` inputs (Wan, Seedance, MiniMax…): reference images and synthesized voice tracks are served
# through signed links under /api/studio/public/. Leave empty on a laptop without a public address.
STUDIO_PUBLIC_URL=
# Secret used to sign those links (falls back to AUTH_SECRET).
STUDIO_MEDIA_SECRET=

# Social publishing (per workspace, connected from the "Réseaux sociaux" screen). Needs STUDIO_PUBLIC_URL above.
# Encrypts stored access/refresh tokens (falls back to AUTH_SECRET): `openssl rand -hex 32`.
SOCIAL_TOKEN_SECRET=
# Facebook Pages + Instagram: Meta app (developers.facebook.com).
META_APP_ID=
META_APP_SECRET=
# TikTok: app with Login Kit + Content Posting API (developers.tiktok.com).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Scheduled posts. With Convex (CONVEX_URL) Convex sends them itself: run `npm run convex:sync-env` so it knows the settings above.
# Without Convex, a long-running server sends them with a built-in once-a-minute ticker (SOCIAL_SCHEDULER=off disables it).
# On Vercel/serverless (without Convex) set CRON_SECRET and call GET /api/studio/social/run-due every minute with `Authorization: Bearer <CRON_SECRET>`.
SOCIAL_SCHEDULER=
CRON_SECRET=
